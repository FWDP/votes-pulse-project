FROM node:22-bookworm-slim

ENV NODE_ENV=production \
    BACKEND_HOST=0.0.0.0 \
    PORT=8787 \
    npm_config_update_notifier=false

WORKDIR /app

COPY package.json package-lock.json ./

RUN set -ex && \
    npm ci --omit=dev --ignore-scripts 2>&1 | grep -v "npm warn" || true && \
    npm cache clean --force || true

COPY --chown=node:node backend ./backend

USER node

EXPOSE 8787

HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["node", "-e", "fetch('http://127.0.0.1:8787/api/health').then(response => { if (!response.ok) process.exit(1) }).catch(() => process.exit(1))"]

CMD ["node", "--import", "tsx", "backend/src/server.ts"]
