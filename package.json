{
  "name": "votes",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "data:normalize:elections": "tsx backend/scripts/normalizeElectionData.ts",
    "data:normalize:election-subdivisions": "tsx backend/scripts/normalizeLegislativeDistrictSubdivisions.ts",
    "data:fetch:election-barangay-boundaries": "tsx backend/scripts/fetchLegislativeBarangayBoundaries.ts",
    "data:generate:election-boundaries": "tsx backend/scripts/generateLegislativeDistrictBoundaries.ts",
    "data:sync:election-boundaries": "tsx backend/scripts/syncLegislativeBoundaryTemplate.ts",
    "data:clean:election-boundaries": "tsx backend/scripts/cleanLegislativeBoundaryTopology.ts",
    "data:validate:elections": "tsx backend/scripts/validateElectionData.ts",
    "db:migrate": "tsx backend/db/runMigrations.ts",
    "db:seed": "tsx backend/db/seed.ts",
    "test:elections": "node --import tsx --test backend/tests/elections.service.test.ts frontend/tests/elections.utils.test.ts",
    "test:auth": "node --import tsx --test frontend/tests/auth.license.test.ts",
    "test:maps": "node --import tsx --test backend/tests/geography.boundaries.test.ts frontend/tests/geojson.test.ts frontend/tests/ncrDistricts.test.ts",
    "test:reports": "env FIELD_REPORTS_MEMORY_ONLY=true node --import tsx --test backend/tests/fieldReports.service.test.ts",
    "test:integrity": "node --import tsx --test backend/tests/reportIntegrity.test.ts backend/tests/reportIntegrity.db.test.ts backend/tests/stellarReadiness.test.ts backend/tests/criticalIntegrityExtensions.test.ts backend/tests/criticalIntegrityExtensions.db.test.ts backend/tests/auth.middleware.test.ts",
    "integrity:mainnet-check": "node --import tsx backend/scripts/checkStellarMainnetReadiness.ts",
    "integrity:estimate-cost": "node --import tsx backend/scripts/measureStellarIntegrity.ts",
    "integrity:release-gate": "node --import tsx backend/scripts/checkIntegrityReleaseGate.ts",
    "integrity:anchor-source": "node --import tsx backend/scripts/anchorDataProvenance.ts",
    "contract:build": "stellar contract build --manifest-path contracts/Cargo.toml",
    "contract:test": "cargo test --manifest-path contracts/Cargo.toml",
    "test:release": "npm run test:reports && npm run test:integrity && npm run type-check && npm run mobile:type-check && npm run contract:test && npm run build",
    "dev": "concurrently -k \"npm:dev:server\" \"npm:dev:client\"",
    "dev:client": "vite",
    "dev:server": "tsx watch backend/src/server.ts",
    "mobile:start": "npm --prefix mobile run start",
    "mobile:android": "npm --prefix mobile run android",
    "mobile:start:dev-client": "npm --prefix mobile run start:dev-client",
    "mobile:android:dev-client": "npm --prefix mobile run android:dev-client",
    "mobile:type-check": "npm --prefix mobile run type-check",
    "build": "vite build",
    "preview": "vite preview",
    "start:server": "node dist-server/index.js",
    "type-check": "tsc --noEmit -p tsconfig.app.json --pretty false && tsc --noEmit -p tsconfig.server.json --pretty false"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^17.0.1",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.2.0",
    "@vitejs/plugin-react": "^6.0.4",
    "bcryptjs": "^3.0.3",
    "cheerio": "^1.2.0",
    "concurrently": "^10.0.4",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.468.0",
    "multer": "^2.2.0",
    "pg": "^8.23.0",
    "polygon-clipping": "^0.15.7",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.10.1",
    "tsx": "^4.23.5",
    "vite": "^8.1.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "typescript": "~6.0.3"
  },
  "allowScripts": {
    "esbuild@0.28.1": true
  }
}
