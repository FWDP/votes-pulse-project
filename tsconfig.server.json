{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "rootDir": ".",
    "outDir": "dist-server",
    "types": ["node"],
    "jsx": "react-jsx",
    "noEmit": true
  },
  "include": ["backend/src/**/*.ts", "backend/tests/**/*.ts", "shared/**/*.ts"]
}
