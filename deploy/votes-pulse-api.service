[Unit]
Description=PULSE source connector API
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=peej
Group=peej
WorkingDirectory=/home/peej/Documents/Work/FWDP/votes-pulse
Environment=NODE_ENV=production
EnvironmentFile=-/home/peej/Documents/Work/FWDP/votes-pulse/backend/.env
ExecStart=/usr/bin/node --import tsx /home/peej/Documents/Work/FWDP/votes-pulse/backend/src/server.ts
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
