PSA_PSGC_TOKEN=
PSA_PSGC_VERSION=Q2_2024

MELTWATER_API_KEY=your-secret-key
MELTWATER_SEARCH_ID=12345678

BACKEND_HOST=127.0.0.1
PORT=8787

# Development-only fallback when no seeded database user is available.
MOBILE_PROTOTYPE_PASSWORD=prototype
# Never enable this in a public production deployment. Local Compose overrides it.
MOBILE_AUTH_PROTOTYPE_ONLY=false
MOBILE_PROTOTYPE_TENANT_ID=tenant-ramon-de-la-cruz-office
MOBILE_PROTOTYPE_WORKSPACE_ID=workspace-constituent-sentiment

VITE_API_BASE_URL=

# Soroban report-integrity worker (Testnet defaults). Keep the signer secret in
# a secrets manager outside local development.
STELLAR_INTEGRITY_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_INTEGRITY_CONTRACT_ID=CCSUQUHI3U25WIZFDODQDC7T4MGKRVAIXVQVIITESQDFYAGMQ6J5KFFA
STELLAR_INTEGRITY_SIGNER_SECRET=
# Preferred for containers/production: mount a 0600 secret file instead of
# placing the secret directly in the process environment.
STELLAR_INTEGRITY_SIGNER_SECRET_FILE=
# Production alternative: a private signing service backed by KMS/HSM. Legacy
# envelope mode returns signedTransactionXdr. Mainnet auth-entry mode receives
# the authorization preimage plus SHA-256 payload and returns a base64 Ed25519
# signature without signing or modifying the full transaction envelope.
STELLAR_INTEGRITY_SIGNER_URL=
STELLAR_INTEGRITY_SIGNER_PUBLIC_KEY=
STELLAR_INTEGRITY_SIGNER_TOKEN_FILE=
# Scope the writer to Soroban authorization entries while a separate, low-balance
# account pays transaction fees. Required on Mainnet.
STELLAR_INTEGRITY_AUTH_ENTRY_SIGNING=false
STELLAR_INTEGRITY_AUTH_ENTRY_VALID_LEDGERS=120
STELLAR_INTEGRITY_FEE_PAYER_SECRET=
STELLAR_INTEGRITY_FEE_PAYER_SECRET_FILE=
STELLAR_INTEGRITY_ADMIN_PUBLIC_KEY=
STELLAR_INTEGRITY_ADMIN_MIN_APPROVALS=1
STELLAR_INTEGRITY_WORKER_INTERVAL_MS=5000
STELLAR_INTEGRITY_MAX_ATTEMPTS=8
STELLAR_INTEGRITY_TTL_SWEEP_ENABLED=true
STELLAR_INTEGRITY_TTL_SWEEP_INTERVAL_MS=21600000
STELLAR_INTEGRITY_TTL_REFRESH_DAYS=14
STELLAR_INTEGRITY_TTL_BATCH_SIZE=10
STELLAR_INTEGRITY_PENDING_ALERT_SECONDS=300
STELLAR_INTEGRITY_RECONCILIATION_ENABLED=true
STELLAR_INTEGRITY_RECONCILIATION_INTERVAL_MS=3600000
STELLAR_INTEGRITY_RECONCILIATION_BATCH_SIZE=20
# Optional HTTPS webhook for durable integrity incident alerts.
STELLAR_INTEGRITY_ALERT_WEBHOOK_URL=
STELLAR_INTEGRITY_ALERT_WEBHOOK_TOKEN=
STELLAR_INTEGRITY_ALERT_WEBHOOK_TOKEN_FILE=
# Mainnet remains disabled unless deployment approval is explicit. Prefer a remote signer.
STELLAR_INTEGRITY_PUBLIC_DEPLOYMENT_APPROVED=false
STELLAR_INTEGRITY_ALLOW_LOCAL_PUBLIC_SIGNER=false
STELLAR_INTEGRITY_EVENT_INGESTION_ENABLED=true
STELLAR_INTEGRITY_EVENT_INGESTION_INTERVAL_MS=60000
STELLAR_INTEGRITY_EVENT_INGESTION_MAX_PAGES=10
# Set to the contract deployment ledger before the first production start.
STELLAR_INTEGRITY_EVENT_START_LEDGER=0
# Optional off-site append-only event archive. Required on Mainnet.
STELLAR_INTEGRITY_ARCHIVE_WEBHOOK_URL=
STELLAR_INTEGRITY_ARCHIVE_WEBHOOK_TOKEN=
STELLAR_INTEGRITY_ARCHIVE_WEBHOOK_TOKEN_FILE=
# Mainnet release evidence consumed by `npm run integrity:mainnet-check`.
STELLAR_INTEGRITY_EXPECTED_WASM_SHA256=
STELLAR_INTEGRITY_DEPLOYMENT_TRANSACTION=
STELLAR_INTEGRITY_SECURITY_REVIEW_ID=
STELLAR_INTEGRITY_LOAD_TEST_REPORT=
STELLAR_INTEGRITY_RELEASE_GATE_ID=
STELLAR_INTEGRITY_RELEASE_SUBJECT_SHA256=
