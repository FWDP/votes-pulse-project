PSA_PSGC_TOKEN=
PSA_PSGC_VERSION=Q2_2024

MELTWATER_API_KEY=your-secret-key
MELTWATER_SEARCH_ID=12345678

BACKEND_HOST=127.0.0.1
PORT=8787

# Development-only fallback when no seeded database user is available.
MOBILE_PROTOTYPE_PASSWORD=prototype
# Never enable this in a public production deployment. Local Compose overrides it.
MOBILE_AUTH_PROTOTYPE_ONLY=false
MOBILE_PROTOTYPE_TENANT_ID=tenant-ramon-de-la-cruz-office
MOBILE_PROTOTYPE_WORKSPACE_ID=workspace-constituent-sentiment

VITE_API_BASE_URL=

# Soroban report-integrity worker (Testnet defaults). Keep the signer secret in
# a secrets manager outside local development.
STELLAR_INTEGRITY_ENABLED=false
STELLAR_NETWORK=testnet
STELLAR_RPC_URL=https://soroban-testnet.stellar.org
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015
STELLAR_INTEGRITY_CONTRACT_ID=CCSUQUHI3U25WIZFDODQDC7T4MGKRVAIXVQVIITESQDFYAGMQ6J5KFFA
STELLAR_INTEGRITY_SIGNER_SECRET=
# Preferred for containers/production: mount a 0600 secret file instead of
# placing the secret directly in the process environment.
STELLAR_INTEGRITY_SIGNER_SECRET_FILE=
STELLAR_INTEGRITY_WORKER_INTERVAL_MS=5000
STELLAR_INTEGRITY_MAX_ATTEMPTS=8
