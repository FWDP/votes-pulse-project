NODE_ENV=production
DATABASE_URL=postgres://votes_app:replace-me@127.0.0.1:5432/votes_pulse
CORS_ORIGIN=https://votes.example.org

STELLAR_INTEGRITY_ENABLED=true
STELLAR_NETWORK=public
STELLAR_NETWORK_PASSPHRASE=Public Global Stellar Network ; September 2015
STELLAR_RPC_URL=https://replace-with-approved-mainnet-rpc.example
STELLAR_INTEGRITY_CONTRACT_ID=
STELLAR_INTEGRITY_SIGNER_URL=https://replace-with-private-signer.example/sign
STELLAR_INTEGRITY_SIGNER_PUBLIC_KEY=
STELLAR_INTEGRITY_ADMIN_PUBLIC_KEY=
STELLAR_INTEGRITY_ADMIN_MIN_APPROVALS=2
STELLAR_INTEGRITY_AUTH_ENTRY_SIGNING=true
STELLAR_INTEGRITY_AUTH_ENTRY_VALID_LEDGERS=120
STELLAR_INTEGRITY_PUBLIC_DEPLOYMENT_APPROVED=false
STELLAR_INTEGRITY_ALLOW_LOCAL_PUBLIC_SIGNER=false

STELLAR_INTEGRITY_WORKER_INTERVAL_MS=5000
STELLAR_INTEGRITY_MAX_ATTEMPTS=8
STELLAR_INTEGRITY_TTL_SWEEP_ENABLED=true
STELLAR_INTEGRITY_TTL_SWEEP_INTERVAL_MS=21600000
STELLAR_INTEGRITY_TTL_REFRESH_DAYS=14
STELLAR_INTEGRITY_TTL_BATCH_SIZE=10
STELLAR_INTEGRITY_RECONCILIATION_ENABLED=true
STELLAR_INTEGRITY_RECONCILIATION_INTERVAL_MS=3600000
STELLAR_INTEGRITY_RECONCILIATION_BATCH_SIZE=20
STELLAR_INTEGRITY_EVENT_INGESTION_ENABLED=true
STELLAR_INTEGRITY_EVENT_INGESTION_INTERVAL_MS=60000
STELLAR_INTEGRITY_EVENT_INGESTION_MAX_PAGES=10
STELLAR_INTEGRITY_EVENT_START_LEDGER=0
STELLAR_INTEGRITY_ALERT_WEBHOOK_URL=https://replace-with-alert-receiver.example/integrity
STELLAR_INTEGRITY_ARCHIVE_WEBHOOK_URL=https://replace-with-archive-receiver.example/stellar-events

STELLAR_INTEGRITY_EXPECTED_WASM_SHA256=4ffd8b15ce098262f91dafd54c7eb59398624b43b1b65929d15d41e16be6f12d
STELLAR_INTEGRITY_DEPLOYMENT_TRANSACTION=
STELLAR_INTEGRITY_SECURITY_REVIEW_ID=
STELLAR_INTEGRITY_LOAD_TEST_REPORT=
STELLAR_INTEGRITY_RELEASE_GATE_ID=
STELLAR_INTEGRITY_RELEASE_SUBJECT_SHA256=

# Read by Docker Compose for host-side secret mounts, never by the API.
STELLAR_SIGNER_TOKEN_HOST_FILE=/secure/path/stellar-signer-token
STELLAR_ALERT_TOKEN_HOST_FILE=/secure/path/stellar-alert-token
STELLAR_FEE_PAYER_SECRET_HOST_FILE=/secure/path/stellar-fee-payer-secret
STELLAR_ARCHIVE_TOKEN_HOST_FILE=/secure/path/stellar-archive-token
